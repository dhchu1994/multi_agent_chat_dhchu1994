# =============================================================================
# Interaction Portal: Environment Configuration Template
# =============================================================================
# Copy this file to '.env' in the project root to set local process defaults.
#
# Configuration Precedence Hierarchy:
#   1. Process environment variables (such as variables set on the command line).
#   2. Local '.env' file in the project root directory or 'config/.env'.
#   3. Built-in defaults defined in 'config/config.yaml'.
#
# Variables defined in '.env' will never overwrite variables already present in
# the active system or command-line environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Operational Mode and Server Settings
# -----------------------------------------------------------------------------
# Run in standalone testing mode (1 / true) or production mode (0 / false).
# Standalone mode enables http://localhost:8000/ with a participant test launcher.
PORTAL_STANDALONE=1

# Application environment: development | testing | production
PORTAL_ENV=development

# Network host address and port number.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000

# Secret key used for signing session cookies. Must be changed in production.
PORTAL_SECRET_KEY=change-me-in-production

# Authentication token required for accessing administrative export endpoints (/admin/export/*).
PORTAL_ADMIN_TOKEN=admin-test-token

# Secret key used for generating and validating study completion codes with Qualtrics.
PORTAL_COMPLETION_SECRET=change-me-too

# Maximum number of concurrent participant sessions allowed before rejecting new entries.
PORTAL_MAX_PARTICIPANTS=100

# Timer acceleration scale factor (1.0 = real time, 0.05 = accelerated for automated testing).
PORTAL_TIMER_SCALE=1.0

# Set to 1 to bypass the automated self-tests on startup.
# PORTAL_SKIP_STARTUP_TESTS=0

# Enforce secure cookies (requires HTTPS; defaults to true in production, false in standalone).
# PORTAL_COOKIE_SECURE=0

# Optional custom database path (defaults to logs/portal_test.sqlite3 or logs/portal.sqlite3).
# PORTAL_DB_PATH=logs/portal_test.sqlite3

# -----------------------------------------------------------------------------
# Artificial Intelligence (AI) Large Language Model (LLM) Settings
# -----------------------------------------------------------------------------
# Model provider: mock | openai | claude | deepseek | glm | qwen
# 'mock' operates completely offline with deterministic responses and zero API calls.
PORTAL_LLM_PROVIDER=mock

# Pinned model name. When left blank, provider defaults are used:
#   openai:   gpt-5.4-mini
#   claude:   claude-haiku-5-5
#   deepseek: deepseek-flash
#   glm:      glm-5.3-flash
#   qwen:     qwen3.8-flash
# PORTAL_LLM_MODEL=

# Custom endpoint base URL (optional, automatically configured per provider).
# PORTAL_LLM_BASE_URL=

# Universal API key override for any selected provider.
# PORTAL_LLM_API_KEY=

# -----------------------------------------------------------------------------
# Provider-Specific Application Programming Interface (API) Keys
# -----------------------------------------------------------------------------
# OpenAI (ChatGPT)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# GLM / Z.ai (formerly Zhipu AI)
# ZAI_API_KEY=your_zai_api_key_here

# Alibaba Cloud Model Studio / DashScope (Qwen)
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
